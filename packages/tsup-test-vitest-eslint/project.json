{
  "name": "tsup-test-vitest-eslint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tsup-test-vitest-eslint/src",
  "targets": {
    "build": {
      "executor": "@code-fixer-23/nx-tsup:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/tsup-test-vitest-eslint/dist",
        "main": "packages/tsup-test-vitest-eslint/src/index.ts",
        "tsConfig": "packages/tsup-test-vitest-eslint/tsconfig.lib.json",
        "format": [
          "esm"
        ],
        "dts": true,
        "clean": true,
        "sourcemap": false,
        "minify": false
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/tsup-test-vitest-eslint",
        "main": "packages/tsup-test-vitest-eslint/src/index.ts",
        "tsConfig": "packages/tsup-test-vitest-eslint/tsconfig.lib.json",
        "noEmit": true
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "config": "packages/tsup-test-vitest-eslint/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/tsup-test-vitest-eslint/**/*.ts"
        ]
      }
    }
  },
  "tags": []
}
