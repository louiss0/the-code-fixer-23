{
  "name": "@code-fixer-23/nx-jsr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nx-jsr/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/nx-jsr/dist",
        "main": "packages/nx-jsr/src/index.ts",
        "tsConfig": "packages/nx-jsr/tsconfig.lib.json",
        "rootDir": "packages/nx-jsr/src",
        "generatePackageJson": false,
        "assets": [
          {
            "input": "packages/nx-jsr/src",
            "glob": "**/schema.json",
            "output": "."
          },
          {
            "input": "packages/nx-jsr/src",
            "glob": "**/files/**/*",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "dist/{projectName}",
        "tsConfig": "packages/nx-jsr/tsconfig.lib.json",
        "noEmit": true
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "config": "packages/nx-jsr/vitest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["npm:public", "ongoing"]
}
