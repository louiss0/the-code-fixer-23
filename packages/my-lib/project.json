{
  "name": "my-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/my-lib/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/my-lib",
        "main": "packages/my-lib/src/index.ts",
        "tsConfig": "packages/my-lib/tsconfig.lib.json",
        "assets": ["packages/my-lib/*.md", "packages/my-lib/jsr.json"]
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/my-lib",
        "main": "packages/my-lib/src/index.ts",
        "tsConfig": "packages/my-lib/tsconfig.lib.json",
        "noEmit": true
      }
    },
    "publish": {
      "executor": "@code-fixer-23/nx-jsr:publish",
      "options": {
        "packageRoot": "packages/my-lib"
      }
    },
    "version": {
      "executor": "@code-fixer-23/nx-jsr:version",
      "options": {
        "packageRoot": "packages/my-lib"
      }
    },
    "validate": {
      "executor": "@code-fixer-23/nx-jsr:validate",
      "options": {
        "packageRoot": "packages/my-lib"
      }
    }
  }
}
