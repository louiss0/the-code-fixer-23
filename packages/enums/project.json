{
  "name": "enums",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/enums/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm --dir packages/enums run build"
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/enums",
        "main": "packages/enums/src/index.ts",
        "tsConfig": "packages/enums/tsconfig.lib.json",
        "noEmit": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/test-output/vitest/coverage"],
      "options": {
        "command": "pnpm --dir packages/enums run test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/enums run lint"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --workspace-root exec biome format --write packages/enums"
      }
    }
  },
  "tags": []
}
