{
  "name": "@code-fixer-23/enums",
  "version": "1.0.3",
  "type": "module",
  "description": "Typed enum factories for immutable string, number, symbol, and labeled enums.",
  "keywords": [
    "enum",
    "typescript",
    "labeled-enum",
    "factory"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "format": "pnpm --workspace-root exec biome format --write packages/enums",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "vitest": "^3.2.4"
  }
}
