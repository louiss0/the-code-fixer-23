{
  "$schema": "https://json-schema.org/schema",
  "$id": "Library",
  "title": "Tsup Library Generator",
  "description": "Create a new TypeScript library configured with Tsup bundler",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "directory": {
      "type": "string",
      "description": "Directory where the library will be created (defaults to packages)",
      "default": "packages"
    },
    "importPath": {
      "type": "string",
      "description": "The import path (e.g., @scope/package-name)",
      "x-prompt": "What is the import path? (e.g., @scope/package-name)",
      "pattern": "^@[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "description": "Package description",
      "default": ""
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Skip formatting files",
      "default": false
    },
    "testRunner": {
      "type": "string",
      "description": "Test runner to use for the library",
      "enum": ["vitest", "jest", "none"],
      "default": "vitest",
      "x-prompt": {
        "message": "Which test runner would you like to use?",
        "type": "list",
        "items": [
          {
            "value": "vitest",
            "label": "Vitest (Modern, Vite-powered testing - recommended)"
          },
          {
            "value": "jest",
            "label": "Jest (Stable, mature testing framework)"
          },
          {
            "value": "none",
            "label": "None (Skip test setup)"
          }
        ]
      }
    },
    "linter": {
      "type": "string",
      "description": "Linter to use for the library",
      "enum": ["eslint", "biome", "none"],
      "default": "eslint",
      "x-prompt": {
        "message": "Which linter would you like to use?",
        "type": "list",
        "items": [
          {
            "value": "eslint",
            "label": "ESLint (Recommended)"
          },
          {
            "value": "biome",
            "label": "Biome (Fast, all-in-one toolchain)"
          },
          {
            "value": "none",
            "label": "None (Skip linter setup)"
          }
        ]
      }
    }
  },
  "required": ["name", "importPath"]
}
