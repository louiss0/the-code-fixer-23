{
  "name": "@code-fixer-23/nx-tsup",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nx-tsup/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/nx-tsup/dist",
        "main": "packages/nx-tsup/src/index.ts",
        "tsConfig": "packages/nx-tsup/tsconfig.lib.json",
        "rootDir": "packages/nx-tsup/src",
        "generatePackageJson": false,
        "assets": [
          {
            "input": "packages/nx-tsup/src",
            "glob": "**/schema.json",
            "output": "."
          },
          {
            "input": "packages/nx-tsup/src",
            "glob": "**/files/**/*",
            "output": "."
          },
          {
            "input": "packages/nx-tsup",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "packages/nx-tsup",
            "glob": "executors.json",
            "output": "."
          },
          {
            "input": "packages/nx-tsup",
            "glob": "migrations.json",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "dist/{projectName}",
        "tsConfig": "packages/nx-tsup/tsconfig.lib.json",
        "noEmit": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "pnpm --dir packages/nx-tsup run test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/nx-tsup run lint"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/nx-tsup run format"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": []
}
