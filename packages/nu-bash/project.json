{
  "name": "@code-fixer-23/nu-bash",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/nu-bash/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm --dir packages/nu-bash run build"
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "dist/{projectName}",
        "tsConfig": "packages/nu-bash/tsconfig.lib.json",
        "noEmit": true,
        "generatePackageJson": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/nu-bash run lint"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/nu-bash run format"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/test-output/vitest"],
      "options": {
        "command": "pnpm --dir packages/nu-bash run test"
      }
    }
  },
  "tags": []
}
