{
  "name": "@code-fixer-23/create-pi-package",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/create-pi-package/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "configFile": "packages/create-pi-package/vite.config.ts",
        "outputPath": "packages/create-pi-package/dist",
        "tsConfig": "packages/create-pi-package/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "dist/{projectName}",
        "tsConfig": "packages/create-pi-package/tsconfig.lib.json",
        "noEmit": true,
        "generatePackageJson": false
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "configFile": "packages/create-pi-package/vite.config.ts",
        "reportsDirectory": "packages/create-pi-package/test-output/vitest/coverage"
      }
    },
    "lint": {
      "command": "pnpm --dir packages/create-pi-package run lint"
    },
    "activate": {
      "dependsOn": ["build"],
      "command": "pnpm --dir packages/create-pi-package exec dist/index.js"
    },
    "format": {
      "command": "pnpm --dir packages/create-pi-package run format"
    }
  },
  "tags": ["npm:public", "ongoing"]
}
