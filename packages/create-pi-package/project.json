{
  "name": "@code-fixer-23/create-pi-package",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/create-pi-package/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm --dir packages/create-pi-package run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir packages/create-pi-package run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/test-output/vitest"],
      "options": {
        "command": "pnpm --dir packages/create-pi-package run test"
      }
    }
  },
  "tags": ["npm:public", "ongoing"]
}
