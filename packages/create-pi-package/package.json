{
  "scripts": {
    "build": "vite build --config vite.config.ts --mode production",
    "test": "vitest run --config vite.config.ts --passWithNoTests",
    "test:watch": "vitest --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  }
}
