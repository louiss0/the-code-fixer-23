{
  "name": "@code-fixer-23/create-pi-package",
  "version": "1.0.2",
  "type": "module",
  "description": "Scaffold PI packages with prompts, skills, and extensions.",
  "keywords": [
    "cli",
    "generator",
    "pi-package",
    "scaffold"
  ],
  "main": "./dist/index",
  "module": "./dist/index",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-pi-package": "./dist/index"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index",
      "default": "./dist/index"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts --mode production",
    "test": "vitest run --config vite.config.ts --passWithNoTests",
    "test:watch": "vitest --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "format": "biome format --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "commander": "^13.1.0",
    "inquirer": "^13.4.2",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "@types/signale": "^1.4.7",
    "memfs": "^4.57.2"
  }
}
