{
  "name": "create-pi-package",
  "version": "0.1.0",
  "type": "module",
  "description": "Scaffold PI packages with prompts, skills, and extensions.",
  "keywords": [
    "cli",
    "generator",
    "pi-package",
    "scaffold"
  ],
  "bin": {
    "create-pi-package": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
