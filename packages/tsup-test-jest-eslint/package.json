  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.12",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.8.0"
  }
}